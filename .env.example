# CAI Enhanced Configuration Example
# Copy to .env and configure for your environment

# Core LLM Configuration (Required for advanced features)
OPENROUTER_API_KEY=your_openrouter_api_key_here
CAI_MODEL=google/gemini-2.5-flash

# Advanced System Configuration
CAI_LOG_LEVEL=INFO                    # TRACE, DEBUG, INFO, WARN, ERROR
CAI_HTTP_TIMEOUT=60                   # HTTP timeout in seconds
CAI_API_BASE=https://openrouter.ai/api/v1

# Performance Optimization Settings
CAI_ENABLE_CACHING=true              # Enable performance caching
CAI_CACHE_SIZE_MB=256                # Cache size in MB
CAI_PERFORMANCE_MONITORING=true     # Enable performance monitoring

# Error Recovery Configuration
CAI_ERROR_RECOVERY_ENABLED=true     # Enable advanced error recovery
CAI_MAX_RETRY_ATTEMPTS=3            # Maximum retry attempts
CAI_PREDICTIVE_PREVENTION=true      # Enable predictive error prevention

# Resource Management
CAI_MEMORY_WARNING_MB=1024          # Memory warning threshold
CAI_MEMORY_CRITICAL_MB=2048         # Memory critical threshold
CAI_CPU_WARNING_PERCENT=80          # CPU warning threshold
CAI_CPU_CRITICAL_PERCENT=95         # CPU critical threshold

# Workflow Configuration
CAI_ADAPTIVE_TIMEOUTS=true          # Enable adaptive timeout management
CAI_STATE_PERSISTENCE=true          # Enable workflow state persistence
CAI_CHECKPOINT_INTERVAL=300         # State checkpoint interval (seconds)

# Test Infrastructure
CAI_PARALLEL_TESTS=true             # Enable parallel test execution
CAI_TEST_QUALITY_GATES=true         # Enable quality gates
CAI_MUTATION_TESTING=false          # Enable mutation testing (resource intensive)

# Edge Case Management
CAI_EDGE_CASE_DETECTION=true        # Enable edge case detection
CAI_NETWORK_RESILIENCE=true         # Enable network resilience features
CAI_CIRCUIT_BREAKER_ENABLED=true    # Enable circuit breaker pattern

# Docker Configuration (Auto-detected)
# CAI_DOCKER_HOST=unix:///var/run/docker.sock
# CAI_DOCKER_WORKSPACE=/workspace

# MCP Server Configuration
CAI_MCP_CONFIG_PATH=./mcp-config.json
CAI_MCP_AUTO_START=true             # Auto-start MCP servers on startup

# Session Management
CAI_SESSION_PERSISTENCE=true        # Enable session persistence
CAI_SESSION_CONFIG_PATH=~/.config/cai/session.json